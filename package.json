{
  "name": "setlist",
  "version": "0.1.0",
  "description": "Apple Music CLI for power users and AI agents",
  "type": "module",
  "bin": {
    "setlist": "./src/index.ts"
  },
  "scripts": {
    "build": "bun build src/index.ts --compile --outfile dist/setlist",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "lint": "biome check",
    "format": "biome check --write",
    "check": "biome check && bun run typecheck && bun test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^13.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/bun": "latest",
    "typescript": "^5.7.0"
  }
}
